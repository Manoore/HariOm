{
  "appId": "com.divineapp.hariom",
  "appName": "Divine App",
  "webDir": "build",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#FFF8E1",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#8B2500"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#FFF8E1"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#FFF8E1",
    "preferredContentMode": "mobile"
  }
}
