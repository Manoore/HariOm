{
  "expo": {
    "name": "Divine App",
    "slug": "divine-app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#800000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divineapp.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#800000",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.divineapp.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
